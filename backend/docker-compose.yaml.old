services:
  vuln-api:
    build: .
    container_name: wazuh-vuln-api
    command: uvicorn src.api.main:app --host 0.0.0.0 --port 8000 --reload
    env_file:
      - .env
    volumes:
      - ./src:/app/src          # code monté en direct -> reload à chaud
      - ./alembic:/app/alembic
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  postgres:
    image: postgres:16.14-alpine3.23
    container_name: wazuh-vuln-db
    platform: linux/amd64
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-vuln_tracking}
      POSTGRES_USER: ${POSTGRES_USER:-vuln_app}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - postgres-data:/var/lib/postgresql/data
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-vuln_app} -d ${POSTGRES_DB:-vuln_tracking}"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  wazuh-report:
    build: .
    container_name: wazuh-report-weekly
    env_file:
      - .env
    volumes:
      - ./src:/app/src          # code monté en direct
      - ./main.py:/app/main.py
      - ./reports:/app/reports
      - ./logs:/app/logs
      - ./templates:/app/templates:ro
    depends_on:
      postgres:
        condition: service_healthy
    restart: "no"

  reports-web:
    image: nginx:1.31.4
    container_name: wazuh-reports-web
    volumes:
      - ./reports:/usr/share/nginx/html:ro
      - ./nginx/action-plan.conf:/etc/nginx/conf.d/default.conf:ro
      - ./nginx/.htpasswd:/etc/nginx/.htpasswd:ro
    ports:
      - "8088:80"
    restart: unless-stopped

volumes:
  postgres-data:
